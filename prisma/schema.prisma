generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}
model Task {
  id            String   @id @default(cuid())
  cliente       String
  targa         String
  modello       String
  descrizione   String
  priorita      String   // "Bassa", "Media", "Alta"
  status        String   // "In Corso", "Verniciatura", "In Consegna", "Consegnato"
  categoria     String   // "Auto", "Moto"
  dataIngresso  DateTime @default(now())
}